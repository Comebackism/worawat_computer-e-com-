# Frontend + API settings. Copy to `.env` and change what you need.

# Where the storefront sends its API calls.
# Leave it unset to use relative /api (Vite proxy in dev, same origin in prod).
# VITE_API_URL=http://localhost:4000/api

# Dev proxy target, if the API is not on port 4000.
# VITE_PROXY_TARGET=http://localhost:4000

# Port for the Express API.
# PORT=4000

# ---------------------------------------------------------------------------
# Database.
#
# Leave this unset locally: the API then persists to server/data/db.json.
# Set it and the API keeps everything in Postgres instead — required in
# production, where the container's filesystem is wiped on every deploy.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_SSL=true    # force TLS when the URL does not carry sslmode itself

# ---------------------------------------------------------------------------
# Sessions and the admin account.
#
# AUTH_SECRET signs the session cookie. Without it the API generates a random
# key per start, which invalidates every session on restart and breaks
# multi-instance deploys. Set a long random string in production.
# ---------------------------------------------------------------------------
# AUTH_SECRET=change-me-to-a-long-random-string

# ADMIN_PASSWORD rotates (or creates) the admin account on every start. Set it
# in production so the account never keeps a demo password. ADMIN_EMAIL defaults
# to admin@worawat.com.
# ADMIN_EMAIL=admin@worawat.com
# ADMIN_PASSWORD=

# Extra origins allowed to call the API with credentials, comma-separated.
# Leave unset for the default same-origin deployment.
# CORS_ORIGINS=https://shop.example.com

# ---------------------------------------------------------------------------
# Google Sign-In (optional).
#
# Create an OAuth 2.0 "Web application" client in Google Cloud Console, add
# http://localhost:5173 and http://localhost:4000 to "Authorised JavaScript
# origins", then paste the client ID into both values below. The same ID is
# used by the storefront and by the API when it verifies Google ID tokens.
# ---------------------------------------------------------------------------
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# PromptPay (Thai QR Payment) receiving account.
#
# VITE_PROMPTPAY_PHONE  mobile number or national/tax ID that receives the money
# VITE_PROMPTPAY_NAME   merchant name written INTO the QR code. EMVCo only allows
#                       the Latin "ans" charset here, so keep it ASCII; this is
#                       the spelling every Thai bank app will show.
# VITE_PROMPTPAY_DISPLAY_NAME  your name as shown in the checkout UI (Thai is fine)
# VITE_PROMPTPAY_CITY   merchant city tag
# ---------------------------------------------------------------------------
# VITE_PROMPTPAY_PHONE=0828072613
# VITE_PROMPTPAY_NAME=WORAWAT BOONRUENG
# VITE_PROMPTPAY_DISPLAY_NAME=วรวัฒน์ บุญเรือง
# VITE_PROMPTPAY_CITY=BANGKOK